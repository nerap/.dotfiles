#!/usr/bin/env bash
# devbox — drive the EC2 dev box from your laptop.
#
#   devbox up         start it, refresh SSH config, attach tmux   (the everyday one)
#   devbox down       stop it now (billing pauses; disks persist)
#   devbox status     state / type / ip / cost-so-far-today
#   devbox ssh        shell on the box (no tmux attach)
#   devbox attach     attach the remote tmux
#   devbox provision  (re)install tooling + dotfiles over SSH, agent-forwarded
#   devbox forwards   rewrite ~/.ssh/devbox.conf with the dev-port tunnels
#
# Config (override via env or ~/.config/devbox.env):
#   DEVBOX_PROFILE=admin   DEVBOX_REGION=eu-west-3   DEVBOX_NAME=devbox
set -uo pipefail

[ -f "$HOME/.config/devbox.env" ] && . "$HOME/.config/devbox.env"
PROFILE="${DEVBOX_PROFILE:-admin}"
REGION="${DEVBOX_REGION:-eu-west-3}"
NAME="${DEVBOX_NAME:-devbox}"
USER_REMOTE="${DEVBOX_USER:-ubuntu}"
SSH_CONF="$HOME/.ssh/devbox.conf"

aws_() { aws --profile "$PROFILE" --region "$REGION" "$@"; }
die() { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
say() { printf '\033[1;36m▸ %s\033[0m\n' "$*" >&2; }

instance_id() {
  aws_ ec2 describe-instances \
    --filters "Name=tag:Name,Values=$NAME" "Name=instance-state-name,Values=pending,running,stopping,stopped" \
    --query 'Reservations[0].Instances[0].InstanceId' --output text 2>/dev/null
}
state()  { aws_ ec2 describe-instances --instance-ids "$1" --query 'Reservations[0].Instances[0].State.Name' --output text 2>/dev/null; }
pub_ip() { aws_ ec2 describe-instances --instance-ids "$1" --query 'Reservations[0].Instances[0].PublicIpAddress' --output text 2>/dev/null; }

# Make sure the AWS (SSO) session is valid; if not, log in. Cached so it only
# checks once per invocation. Prevents the misleading "no instance" error that a
# plain expired token produces.
AUTH_OK=0
ensure_auth() {
  [ "$AUTH_OK" = 1 ] && return 0
  if aws_ sts get-caller-identity >/dev/null 2>&1; then AUTH_OK=1; return 0; fi
  # Non-interactive callers (the launchd auto-refresh) must NEVER trigger an
  # `aws sso login` browser flow — it can't complete headless and would hang the
  # timer. They set DEVBOX_NONINTERACTIVE=1 and we fail cleanly instead.
  if [ "${DEVBOX_NONINTERACTIVE:-0}" = 1 ]; then
    echo "devbox: SSO expired; skipping (non-interactive). Run 'aws sso login --profile $PROFILE'." >&2
    return 1
  fi
  say "AWS SSO session for '$PROFILE' expired — opening browser to log in"
  aws sso login --profile "$PROFILE" >&2 || die "aws sso login failed — run: aws sso login --profile $PROFILE"
  AUTH_OK=1
}

# Make sure port 22 in devbox-sg allows YOUR current IP. ISPs rotate IPs, and a
# stale rule makes `devbox up` hang forever waiting for sshd. Adds the current IP
# (idempotent) and prunes other /32s so the group stays tight.
ensure_sg() {
  local myip sg
  myip=$(curl -fsS4 --max-time 6 https://api.ipify.org 2>/dev/null) || { say "couldn't detect IP — skipping SG check"; return 0; }
  sg=$(aws_ ec2 describe-security-groups --filters "Name=group-name,Values=${NAME}-sg" --query 'SecurityGroups[0].GroupId' --output text 2>/dev/null)
  [ -n "$sg" ] && [ "$sg" != "None" ] || return 0
  local have
  have=$(aws_ ec2 describe-security-groups --group-ids "$sg" --query "SecurityGroups[0].IpPermissions[?FromPort==\`22\`].IpRanges[].CidrIp" --output text 2>/dev/null)
  case " $have " in
    *" $myip/32 "*) return 0 ;;  # already allowed
  esac
  say "IP changed → updating $NAME-sg to allow $myip"
  aws_ ec2 authorize-security-group-ingress --group-id "$sg" --protocol tcp --port 22 --cidr "$myip/32" >/dev/null 2>&1
  local old
  for old in $have; do
    [ "$old" = "$myip/32" ] && continue
    aws_ ec2 revoke-security-group-ingress --group-id "$sg" --protocol tcp --port 22 --cidr "$old" >/dev/null 2>&1
  done
}

need_id() {
  ensure_auth || return 1
  local id; id=$(instance_id)
  [ -n "$id" ] && [ "$id" != "None" ] || die "No instance tagged Name=$NAME in $REGION (profile $PROFILE). Run terraform apply first."
  echo "$id"
}

# Generate the SSH tunnels. Each worktree n exposes: vite 8080+n, and the supabase
# stack at 54321+(n-1)*100 .. +6. Forwarding them means localhost:8081 in your local
# browser still hits worktree 1 — exactly like it does today.
write_ssh_conf() {
  local ip="$1" f="$SSH_CONF"
  {
    echo "# GENERATED by \`devbox forwards\` — do not edit. IP changes on every start."
    echo "Host $NAME"
    echo "  HostName $ip"
    echo "  User $USER_REMOTE"
    echo "  ForwardAgent yes"
    echo "  ServerAliveInterval 30"
    echo "  ServerAliveCountMax 4"
    echo "  ControlMaster auto"
    echo "  ControlPath ~/.ssh/cm-%r@%h:%p"
    echo "  ControlPersist 10m"
    echo "  StrictHostKeyChecking accept-new"
    for n in 1 2 3 4 5 6 7 8; do
      echo "  LocalForward $((8080 + n)) 127.0.0.1:$((8080 + n))   # wt$n vite"
      local base=$((54321 + (n - 1) * 100))
      for o in 0 1 2 3 4 5 6; do
        echo "  LocalForward $((base + o)) 127.0.0.1:$((base + o))"
      done
    done
    # MCP OAuth callback ports on the box. When you authenticate a remote MCP
    # (Notion, Figma, Sentry…) in Claude ON the box, it runs a loopback callback
    # server here; forwarding these lets the Mac browser's redirect reach it.
    for p in 64676 33418 8976; do
      echo "  LocalForward $p 127.0.0.1:$p   # MCP OAuth callback"
    done
  } > "$f"
  chmod 600 "$f"

  # ssh only reads devbox.conf if the main config includes it (must be near the top:
  # ssh takes the FIRST value for each option).
  local main="$HOME/.ssh/config"
  touch "$main"; chmod 600 "$main"
  if ! grep -q '^Include devbox.conf' "$main"; then
    cp "$main" "$main.bak.$(date +%s)"
    printf 'Include devbox.conf\n\n%s' "$(cat "$main")" > "$main.tmp" && mv "$main.tmp" "$main"
    say "added 'Include devbox.conf' to ~/.ssh/config (backup saved)"
  fi
}

cmd_forwards() {
  local id ip; id=$(need_id); ip=$(pub_ip "$id")
  [ -n "$ip" ] && [ "$ip" != "None" ] || die "instance has no public IP (is it running?)"
  write_ssh_conf "$ip"
  say "ssh config -> $SSH_CONF (host: $NAME, ip: $ip, 64 tunnels)"
}

cmd_up() {
  local id st ip; id=$(need_id); st=$(state "$id")
  if [ "$st" != "running" ]; then
    say "starting $id ($st -> running)"
    aws_ ec2 start-instances --instance-ids "$id" >/dev/null || die "start failed"
    aws_ ec2 wait instance-running --instance-ids "$id" || die "never reached running"
  fi
  ensure_sg
  ip=$(pub_ip "$id")
  write_ssh_conf "$ip"
  # Tear down any stale ControlMaster socket. When your laptop IP changes the
  # master TCP dies but its socket lingers, and new ssh calls reuse the dead
  # master and hang — which is what makes `up` "loop". Start clean.
  ssh -O exit "$NAME" 2>/dev/null || true
  rm -f "$HOME"/.ssh/cm-* 2>/dev/null || true
  say "waiting for sshd on $ip"
  local ok=0
  for i in $(seq 1 40); do
    ssh -o ConnectTimeout=4 -o BatchMode=yes -o ControlMaster=no -o ControlPath=none "$NAME" true 2>/dev/null && { ok=1; break; }
    # Re-assert the SG every ~8 tries in case the IP rotated again mid-wait.
    [ $((i % 8)) -eq 0 ] && ensure_sg
    sleep 3
  done
  [ "$ok" = 1 ] || die "sshd unreachable after 2min. Check: aws profile/SSO, and that $NAME-sg allows your IP ($(curl -fsS4 --max-time 5 https://api.ipify.org 2>/dev/null))."
  start_url_watcher
  sync_claude_login
  say "attaching (Ctrl+u for the fleet dashboard)"
  exec ssh -At "$NAME" 'S=$(tmux ls -F "#{session_name}" 2>/dev/null | grep -E "_[1-8]$" | sort | head -1); [ -n "$S" ] && exec tmux attach -t "$S"; exec tmux attach 2>/dev/null || exec tmux new -s main'
}

# Push THIS Mac's current Claude credential to the box on every connect. The Mac
# and box share one OAuth credential, and the Mac rotates the refresh token when
# it refreshes — which silently invalidates the box's copy (the recurring
# "login expired on the box"). Re-copying at each `up`/`attach` means the box
# always starts a session with a fresh, valid credential. Non-fatal.
#
# PREFERRED: install a static ~1-year token on the box with `devbox-claude-token`
# (sets $CLAUDE_CODE_OAUTH_TOKEN via ~/.config/claude-token.env). Once that exists
# the box no longer shares the rotating refresh token, so we SKIP this copy — a
# rotating credential on the box is exactly what we're trying to eliminate.
sync_claude_login() {
  local helper="$HOME/bin/.local/scripts/devbox-claude-login"
  [ -x "$helper" ] || return 0
  # Static token already installed on the box? Then don't re-introduce a rotating one.
  if ssh -o BatchMode=yes -o ConnectTimeout=5 "$NAME" 'test -f ~/.config/claude-token.env' 2>/dev/null; then
    say "claude: box uses static token — skipping credential copy"
    return 0
  fi
  if DEVBOX_NAME="$NAME" "$helper" >/dev/null 2>&1; then
    say "claude login synced to box (fresh credential)"
  else
    say "claude login sync skipped (unlock 1Password / Keychain if login fails on box)"
  fi
}

# Watch the box's URL queue and open each URL in the local (Mac) browser, so
# `claude login` / MCP OAuth / `gh auth` on the box pop THIS machine's browser.
# If a URL carries an OAuth loopback callback (redirect_uri=http://localhost:PORT),
# dynamically forward THAT port to the box first — Claude picks a random callback
# port per attempt, so fixed forwards can't work. This makes remote MCP OAuth
# (Notion, Figma, Sentry, …) and `claude login` on the box just work.
start_url_watcher() {
  local pidf="$HOME/.cache/devbox-url-watcher.pid"
  mkdir -p "$HOME/.cache"
  if [ -f "$pidf" ] && kill -0 "$(cat "$pidf" 2>/dev/null)" 2>/dev/null; then return; fi
  local host="$NAME"
  ( ssh "$host" 'mkdir -p ~/ 2>/dev/null; : >> ~/.url-open-queue; tail -n0 -F ~/.url-open-queue 2>/dev/null' \
      | while IFS= read -r u; do
          [ -n "$u" ] || continue
          # extract a loopback callback port from the redirect_uri, plain or
          # %-encoded (localhost%3A52329 or localhost:52329). grep -oE is portable
          # on macOS BSD sed can't do alternation. Take the digits after the colon.
          port=$(printf '%s' "$u" \
            | grep -oiE '(localhost|127\.0\.0\.1)(:|%3a)[0-9]+' \
            | grep -oE '[0-9]+$' | head -1)
          if [ -n "$port" ]; then
            # add the forward to the existing master (idempotent; ignore if present)
            ssh -O forward -L "$port:localhost:$port" "$host" 2>/dev/null || true
          fi
          open "$u"
        done ) >/dev/null 2>&1 &
  echo $! > "$pidf"
  say "url-watcher on — browser opens + OAuth callbacks (any port) route to this Mac"
}

cmd_down() {
  local id; id=$(need_id)
  say "stopping $id — disks persist, billing for compute stops"
  aws_ ec2 stop-instances --instance-ids "$id" >/dev/null || die "stop failed"
  aws_ ec2 wait instance-stopped --instance-ids "$id" && say "stopped"
}

cmd_status() {
  local id; id=$(need_id)
  aws_ ec2 describe-instances --instance-ids "$id" \
    --query 'Reservations[0].Instances[0].{State:State.Name,Type:InstanceType,IP:PublicIpAddress,Since:LaunchTime}' \
    --output table
  if [ "$(state "$id")" = "running" ]; then
    ssh -o ConnectTimeout=4 -o BatchMode=yes "$NAME" \
      'echo; uptime; echo; tmux list-sessions 2>/dev/null | head -20; echo; ls -1 ~/.devbox-nostop 2>/dev/null && echo "(auto-stop DISABLED)"' 2>/dev/null
  fi
}

cmd_ssh()    { local id; id=$(need_id); [ "$(state "$id")" = running ] || die "not running — devbox up"; exec ssh -A "$NAME"; }
cmd_attach() { local id; id=$(need_id); [ "$(state "$id")" = running ] || die "not running — devbox up"; sync_claude_login; exec ssh -At "$NAME" 'S=$(tmux ls -F "#{session_name}" 2>/dev/null | grep -E "_[1-8]$" | sort | head -1); [ -n "$S" ] && exec tmux attach -t "$S"; exec tmux attach 2>/dev/null || exec tmux new -s main'; }
cmd_relogin() {
  local id; id=$(need_id) || { echo "devbox relogin: skipped (SSO/creds unavailable)"; exit 0; }
  [ "$(state "$id")" = running ] || { echo "devbox relogin: box not running — skipped"; exit 0; }
  sync_claude_login
}

cmd_provision() {
  local id; id=$(need_id)
  [ "$(state "$id")" = running ] || die "not running — devbox up"
  ssh-add -l >/dev/null 2>&1 || die "no SSH agent — the box needs your forwarded key to clone private repos"
  cmd_forwards
  say "provisioning (agent-forwarded, so no credentials land on the box)"
  scp "$HOME/personal/dotfiles/infra/ec2-devbox/bootstrap.sh" "$NAME:/tmp/bootstrap.sh" || die "scp failed"
  exec ssh -At "$NAME" "IDLE_MINUTES=${DEVBOX_IDLE_MINUTES:-30} bash /tmp/bootstrap.sh"
}

case "${1:-}" in
  up)        cmd_up ;;
  relogin)   cmd_relogin ;;
  down|stop) cmd_down ;;
  status)    cmd_status ;;
  ssh)       cmd_ssh ;;
  attach)    cmd_attach ;;
  provision) cmd_provision ;;
  forwards)  cmd_forwards ;;
  *) sed -n '2,20p' "$0" | sed 's/^# \?//'; exit 1 ;;
esac
